{
  "name": "right-there",
  "version": "0.1.0",
  "private": true,
  "description": "Right There — show your partner where to massage, without saying a word. Prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "node scripts/dev-phone.mjs",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/right-there.html')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && node scripts/e2e.mjs && node scripts/e2e-engines.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cloudflared": "^0.7.3",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
